# Pick either release or debug. Almost always "release".
GIN_MODE=release

# What address and port will TPS listen on?
BIND_ADDR=:8080

# Turnstile keys - you need to have a cloudflare login for this
TURNSTILE_SITE_KEY=foo
TURNSTILE_SECRET_KEY=bar

# Choose something long and secure here for encrypting the JWT cookie
JWT_SIGNING_KEY=shhhhhh-this-is-very-secret

# The backend TPS proxies verified requests to. This should be a *private*
# URL, not a public one, as Caddy and TPS should be fronting the protected app.
#
# TPS proxies everything you route to it here. Sending different paths to
# different backends is your front proxy's job: either route each protected
# path to its own TPS instance, or point TPS at an internal listener on your
# front proxy that does the routing (see example/ for the latter).
PROXY_TARGET="http://localhost"

# Where will you record the stats? TPS logs one decision event per request
# (challenge served, verified, proxied, etc.) to an embedded SQLite database at
# this path; the file is created if it doesn't exist. If unset, event logging
# is disabled and TPS runs without a database. Query it with the sqlite3 CLI,
# e.g. `SELECT outcome, reason, COUNT(*) FROM events GROUP BY 1, 2;`.
LOG_DB_PATH="/var/local/tps/data/tps.db"

# How long to keep logged events, as a Go duration string. Older events are
# pruned hourly. Defaults to 48h; "0" keeps events forever. Only the
# detailed per-request log is pruned; the hourly aggregates behind /.tps/report
# are kept forever, so a short retention still leaves long-term report data.
LOG_RETENTION="48h"

# Where are custom templates (if any) found? Put challenge.go.html and
# failed.go.html here and they replace TPS's built-in pages everywhere. Per-host
# and per-path overrides live in subdirectories: <hostname>/challenge.go.html,
# <hostname>/<url path>/challenge.go.html.
TEMPLATE_PATH="/var/local/tps/templates"

# How long a solved challenge stays valid, as a Go duration string ("30m",
# "1h", "90m"). Shorter lifetimes mean bots have to re-solve (or re-buy
# solves) more often, at the cost of legitimate users seeing the challenge
# more often. Defaults to 4h.
TOKEN_LIFETIME=4h

# Client binding: tokens are tied to the client that solved the challenge so
# one solved challenge can't be shared across a botnet.
#
# TOKEN_BIND_USER_AGENT (default true) is a hard binding: a token presented
# with a different User-Agent is rejected and the client is re-challenged.
#
# The client IP is also tracked -- the exact address for IPv4, the /64
# prefix for IPv6 -- but that isn't configurable. While TOKEN_REQUEST_BUDGET
# is enabled (the default), an IP change costs budget instead of triggering
# a re-challenge; set the budget to 0 and the IP becomes a hard binding like
# the User-Agent.
TOKEN_BIND_USER_AGENT=true

# Request budget: each token is good for this many requests before the
# client must solve a new challenge (0 disables the budget). A request from
# the same IP as the token's previous request costs 1; a request from a
# different IP costs TOKEN_IP_SWITCH_COST. Humans on expensive
# endpoints never notice 1000 over a 4h token (~4 requests/minute,
# sustained); a mobile user pays the switch cost a few times a day; a bot
# rotating IPs per request gets budget/cost (default: 100) requests per
# solved challenge.
#
# Sophisticated bots that batch requests per IP (or keep one cookie jar per
# IP) avoid the switch cost entirely; for them the budget itself is the only
# limit. If they're still a problem, lower TOKEN_REQUEST_BUDGET to force
# more solves -- humans on expensive endpoints won't notice until it gets
# very low.
#
# IMPORTANT: do not protect paths that serve static assets (CSS, JS, images).
# Budget goes too fast, and if a challenge is initiated when requesting any
# non-navigation asset, the site breaks.
TOKEN_REQUEST_BUDGET=1000
TOKEN_IP_SWITCH_COST=10

# Memory a challenge is allowed to cost TPS.
#
# To serve a challenge, TPS has to hold onto the original request so it can be
# replayed once the client solves it. That's memory an *unverified* client --
# which is to say, any bot -- gets to make TPS allocate, and it's held for the
# five minutes a pending challenge lives, whether or not the client is still
# there.
#
# MAX_CHALLENGE_BODY (bytes, default 1MiB) is the largest single request body
# TPS will buffer for a client it hasn't verified yet. Bigger gets a 413.
#
# MAX_CHALLENGE_CACHE (bytes, default 256MiB) is the ceiling across every
# challenge pending at once. Once it's full, further challenges are shed with a
# 503 until some expire -- one client loses a challenge, instead of the whole
# gate being lost to an out-of-memory kill. It must be at least
# MAX_CHALLENGE_BODY (plus a small per-request overhead), or requests of the
# size you just permitted would be shed the moment they arrived.
#
# Neither limit touches verified traffic: a request with a live token is
# streamed straight to the backend and never buffered, so a user who has
# solved a challenge can upload whatever your backend accepts. Raise
# MAX_CHALLENGE_BODY only if unverified clients legitimately POST large bodies
# to you -- an API client hitting a protected endpoint cold, say.
MAX_CHALLENGE_BODY=1048576
MAX_CHALLENGE_CACHE=268435456

# Shared secret that unlocks TPS's analytics endpoint under the reserved
# /.tps/ path: /.tps/report (JSON challenge stats). When unset, the endpoint is
# DISABLED and returns 404 -- it is strictly opt-in, because TPS is meant to
# sit on a private network, not face the web. When set, callers must present it
# as a bearer token ("Authorization: Bearer <secret>") or a "key" query
# parameter, e.g. /.tps/report?key=<secret>.
#
# The /.tps/beacon endpoint (used by the challenge page to report that the
# client ran JavaScript -- the "smart vs dumb bot" signal) is always public and
# is unaffected by this secret. For any of /.tps/ to work, your front proxy must
# route /.tps/ to TPS. See "Analytics" in the README for how to expose the
# report endpoint safely.
ADMIN_SECRET="choose-another-long-random-value"
