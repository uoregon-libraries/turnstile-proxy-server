{
  debug
  servers {
    trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
    trusted_proxies_strict
    client_ip_headers X-Real-IP X-Forwarded-For
  }
}

# Public-facing listener. Both protected prefixes route to the same TPS
# instance, which decides per-request which backend to proxy to based on
# its PROXY_TARGETS config. Everything else goes straight to the app.
#
# SITE_HOST controls the address (and TLS cert) of this listener; it defaults
# to "localhost" so `docker compose up` just works on the same machine. Set it
# to whatever clients use to reach this box and Caddy will serve HTTPS there
# with a cert from its own internal CA — this works for hostnames, raw IPs
# (e.g. SITE_HOST=192.0.2.10), and magic wildcard DNS names
# (e.g. SITE_HOST=192-0-2-10.nip.io). Serving HTTPS is what makes this example
# behave like production: Caddy adds `X-Forwarded-Proto: https`, so TPS marks
# its session cookie Secure, exercising the same cookie path prod uses.
https://{$SITE_HOST:localhost} {
  tls internal
  log

  # In production you usually want static assets to bypass TPS so page loads
  # don't drain the per-token request budget (see TOKEN_REQUEST_BUDGET in the
  # README). That looks like:
  #
  #   @protected {
  #     path /search* /facets*
  #     not path *.css *.js *.png *.jpg *.webp *.svg *.woff2 *.ico
  #   }
  #
  # This example deliberately routes static files through TPS anyway, to
  # demonstrate that protecting them is possible when it's intentional.
  @protected {
    path /protected/* /static-protected/*
  }
  handle @protected {
    reverse_proxy tps:8080
  }

  handle {
    reverse_proxy app:8080
  }
}

# Internal-only listener used as the /static-protected/* backend in TPS's
# PROXY_TARGETS. It serves the static assets directly with no Turnstile rule,
# so when TPS replays a verified request here it does not loop back into a
# challenge. This port is not published in compose.yml, so it is only
# reachable from inside the compose network.
:8081 {
  log

  root * /srv
  file_server
}
